<?xml version="1.0" encoding="utf-8"?>
<!--
  Foreground is a density PNG cut from the generated icon tile by tools/make_app_icon.py,
  and the background is that tile's own surface colour.

  No monochrome layer. The system flattens that layer to a single colour, and an embossed
  render collapses into a featureless blob; without it, Android 13 themed icons fall back to
  the normal icon, which looks far better than the alternative.
-->
<adaptive-icon xmlns:android="http://schemas.android.com/apk/res/android">
    <background android:drawable="@color/anubis_icon_plate" />
    <foreground android:drawable="@mipmap/ic_launcher_foreground" />
</adaptive-icon>
